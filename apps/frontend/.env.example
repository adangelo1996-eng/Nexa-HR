# Backend Nest (stesso valore in produzione: URL pubblico Render / altro host)
# Con o senza /api finale — se ometti /api, il client lo aggiunge (vedi lib/api.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Esempio produzione:
# NEXT_PUBLIC_API_BASE_URL=https://nexa-hr-backend.onrender.com

# Opzionale: per `getSupabaseBrowserClient()` in lib/supabase.ts (oggi i dati HR passano da Nest + JWT)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

