# Backend Nest (stesso valore in produzione: URL pubblico Render / altro host)
# Con o senza /api finale — se ometti /api, il client lo aggiunge (vedi lib/api.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Esempio produzione:
# NEXT_PUBLIC_API_BASE_URL=https://nexa-hr-backend.onrender.com

# Central Hub: senza sessione Nexa si passa dal handoff SSO (stesso login dell'hub).
# In produzione puoi usare solo CENTRAL_HUB_ORIGIN (runtime) oppure NEXT_PUBLIC_* (inline in build).
# Esempio: https://central-hub-next.onrender.com
CENTRAL_HUB_ORIGIN=
NEXT_PUBLIC_CENTRAL_HUB_ORIGIN=

# Obbligatorio per login con Google / Microsoft (Supabase Auth + OAuth). Allineare redirect URL in dashboard Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

