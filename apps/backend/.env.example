API_PORT=4000
CORS_ORIGIN=http://localhost:3000
# Obbligatorio in produzione (NODE_ENV=production); non usare il default di sviluppo.
AUTH_JWT_SECRET=CHANGE_ME_WITH_LONG_RANDOM_SECRET
# Password condivisa per tutti i ruoli (modalità legacy senza Supabase Auth sul backend).
AUTH_SHARED_PASSWORD=Synapse2026
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Opzionale ma consigliata con Supabase Auth: anon key (Dashboard → Settings → API) per verify login senza toccare il client service_role.
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Stesso "JWT Secret" del progetto (Dashboard Supabase → Settings → API). Serve per validare l'access_token dopo OAuth.
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
# Postgres diretto (obbligatorio per import Excel in transazione: DatabasePoolService). Dashboard → Settings → Database → URI (Session pooler, porta 6432, oppure session mode / connessione diretta 5432).
# Accetta uno dei due nomi; su Render usa spesso SUPABASE_DB_URL (vedi render.yaml).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Opzionale in dev: AES-256 per campi PII testuali su public.users (codice fiscale, IBAN, telefono, indirizzo, …).
# Generazione: openssl rand -base64 32  (oppure 64 caratteri esadecimali). Obbligatorio in produzione se si vogliono dati cifrati a riposo lato applicazione.
USER_PII_ENCRYPTION_KEY=
APP_SSO_SHARED_KEY=CHANGE_ME_WITH_SHARED_SECRET_FROM_CENTRAL_HUB
