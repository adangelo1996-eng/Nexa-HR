API_PORT=4000
CORS_ORIGIN=http://localhost:3000
AUTH_JWT_SECRET=CHANGE_ME_WITH_LONG_RANDOM_SECRET
# Password condivisa per tutti i ruoli (modalità legacy senza Supabase Auth sul backend).
AUTH_SHARED_PASSWORD=Synapse2026
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Opzionale ma consigliata con Supabase Auth: anon key (Dashboard → Settings → API) per verify login senza toccare il client service_role.
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Stesso "JWT Secret" del progetto (Dashboard Supabase → Settings → API). Serve per validare l'access_token dopo OAuth.
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
APP_SSO_SHARED_KEY=CHANGE_ME_WITH_SHARED_SECRET_FROM_CENTRAL_HUB

# Apple Wallet (.pkpass) — certificati Apple Developer (Pass Type ID + PEM firma + WWDR).
# Copia i file in apps/backend/certs/ (cartella già prevista nel repo) oppure usa path assoluti.
# Verifica: dalla root del monorepo → pnpm wallet:check:backend
# da apps/backend → pnpm wallet:check
# APPLE_WALLET_CERT_BASE_DIR=
# APPLE_WALLET_PASS_TYPE_ID=pass.com.example.nexahr
# APPLE_WALLET_TEAM_ID=XXXXXXXXXX
# APPLE_WALLET_ORGANIZATION_NAME=Nexa HR
# PEM del certificato Pass Type ID + chiave privata; WWDR scaricabile da Apple (es. https://www.apple.com/certificateauthority/)
# APPLE_WALLET_SIGNER_CERT_PATH=signerCert.pem
# APPLE_WALLET_SIGNER_KEY_PATH=signerKey.pem
# APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
# APPLE_WALLET_WWDR_CERT_PATH=wwdr.pem
