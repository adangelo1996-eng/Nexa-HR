# Opzionale: API key Render (Account → API Keys) per script locali: render-pull-backend-env.mjs, render-update-frontend-start.mjs (root).
# RENDER_API_KEY=rnd_...

API_PORT=4000
CORS_ORIGIN=http://localhost:3000
# Obbligatorio in produzione (NODE_ENV=production); non usare il default di sviluppo.
AUTH_JWT_SECRET=CHANGE_ME_WITH_LONG_RANDOM_SECRET
# Password condivisa per tutti i ruoli (modalità legacy senza Supabase Auth sul backend).
AUTH_SHARED_PASSWORD=Synapse2026
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Opzionale ma consigliata con Supabase Auth: anon key (Dashboard → Settings → API) per verify login senza toccare il client service_role.
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Stesso "JWT Secret" del progetto (Dashboard Supabase → Settings → API). Serve per validare l'access_token dopo OAuth.
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
# Postgres diretto (obbligatorio per import Excel in transazione: DatabasePoolService). Dashboard → Settings → Database → URI (Session pooler, porta 6432, oppure session mode / connessione diretta 5432).
# Accetta uno dei due nomi; su Render usa spesso SUPABASE_DB_URL (vedi render.yaml).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
#
# Migrazioni locali (`pnpm supabase:db:push:remote`) senza IPv6: una delle due opzioni:
# (A) Personal Access Token + password DB utente postgres (Dashboard → Database) → la CLI usa `supabase link`.
# SUPABASE_ACCESS_TOKEN=  # dashboard Supabase → Account → Access Tokens
# SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
# (B) Incolla la URI "Session pooler" (IPv4) da Dashboard → Connect → Session mode (non la direct db.* se la rete non ha IPv6).
# SUPABASE_POOLER_URL=postgres://postgres.YOUR_PROJECT_REF:...@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Opzionale in dev: AES-256 per campi PII testuali su public.users (codice fiscale, IBAN, telefono, indirizzo, …).
# Generazione: openssl rand -base64 32  (oppure 64 caratteri esadecimali). Obbligatorio in produzione se si vogliono dati cifrati a riposo lato applicazione.
USER_PII_ENCRYPTION_KEY=
APP_SSO_SHARED_KEY=CHANGE_ME_WITH_SHARED_SECRET_FROM_CENTRAL_HUB

# AI / pseudonimizzazione confine LLM (solo backend): TTL sessione vault token (secondi, 60–86400; default 1800).
# AI_PRIVACY_SESSION_TTL_SEC=1800
#
# OpenAI (opzionale): solo con NEXA_AI_OPENAI_ENABLED=true il backend invia JSON già pseudonimizzato al modello.
# OPENAI_API_KEY=sk-...
# NEXA_AI_OPENAI_ENABLED=true
# NEXA_OPENAI_MODEL=gpt-4o-mini
# Opzionale: Redis per vault condiviso tra più istanze Render (stesso valore di infra/docker-compose).
# REDIS_URL=redis://127.0.0.1:6379
#
# --- LinkedIn recruiting (webhook intake + job sync) — docs/integrations/linkedin-recruiting-intake.md ---
# Secret condiviso con Zapier/Make (≥16 caratteri). Header: X-Nexa-Signature: sha256=<hmac(raw body)>
# LINKEDIN_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_WEBHOOK_SECRET
# LINKEDIN_WEBHOOK_COMPANY_ID=comp-1
# LINKEDIN_WEBHOOK_ALLOWED_COMPANY_IDS=comp-1
# LINKEDIN_WEBHOOK_RATE_LIMIT_PER_MIN=60
# LINKEDIN_INTEGRATION_ACTOR_USER_ID=
# PUBLIC_API_BASE_URL=https://YOUR_BACKEND.onrender.com/api
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ORGANIZATION_URN=urn:li:organization:123456
# LINKEDIN_JOB_SYNC_ENABLED=false
