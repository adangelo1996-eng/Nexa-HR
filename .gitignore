# Dependencies
node_modules/
# Monorepo usa solo pnpm (evita lockfile npm nelle app)
apps/*/package-lock.json

# pnpm
.pnpm-store/

# Next.js
.next/
out/

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example
.render-api-key

# Apple Wallet — materiale di firma locale (la cartella certs resta nel repo vuota via .gitkeep)
apps/backend/certs/*.pem
apps/backend/certs/*.p12
apps/backend/certs/*.cer
apps/backend/certs/*.key
apps/backend/certs/*.der

# Logs and debug
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/

# Vercel
.vercel

# Supabase local (if used)
infra/supabase/.branches
infra/supabase/.temp
